# Variable NAMES only. Never put real values in this file.
# Local dev: copy to .env.local (git-ignored) and fill in values.
# Hosting (Spacefast Functions): set these in the host's secret/env settings. Locally, `wrangler dev` (test:e2e:worker) takes --var NAME:value.

# development | preview | production. Required in every production build (next start, the worker): it never
# defaults there. memory and mock are development-only; production also refuses demo extraction;
# anything but production refuses live Stripe keys.
SITE_ENV=
# memory | neon. memory signs in any typed email (no verification): development only.
LF_BACKEND=
# mock | stripe. stripe = TEST keys only on this branch; mock is development only.
STRIPE_MODE=
# demo | gemini. Production refuses demo.
EXTRACTION_MODE=

# BUILD-TIME as well as runtime: the sitemap and og:url bake it into the build, so the build that is published
# (npm run build:spacefast) must have it set to the live Spacefast URL, not only the host's runtime env.
NEXT_PUBLIC_APP_URL=

# LF_BACKEND=neon. `neon env pull` writes DATABASE_URL and NEON_AUTH_BASE_URL; keep both server-only (never
# NEXT_PUBLIC_): every Neon Auth call goes through this app's routes and rate limits. Cookie secret: 32+ chars
# (openssl rand -base64 32).
DATABASE_URL=
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

GEMINI_API_KEY=
GEMINI_MODEL=

# Audits one user may start per rolling 24 hours (default 10).
LF_DAILY_AUDIT_LIMIT=
# Per-user (or per-sign-in-email) fixed-window limits as hits/seconds. Defaults: upload 10/60, signin 10/60, checkout 20/60.
# Counted in Neon Postgres (rate_limit_hit); refuses requests if the limiter is unreachable, except in development.
LF_RATE_LIMIT_UPLOAD=
LF_RATE_LIMIT_SIGNIN=
LF_RATE_LIMIT_CHECKOUT=
# A password change needs a sign-in within this many minutes (including a password-reset code sign-in). Default 10.
LF_PASSWORD_CHANGE_RECENT_MINUTES=
# Wrong passwords allowed per sign-in email per window (counted on failures only). Default 5/900.
LF_PASSWORD_FAILURE_LIMIT=
# Header the host sets with the client IP (e.g. x-real-ip). Empty (default) trusts none and turns per-IP limits off.
# Do not set it until a Spacefast preview header-echo test with forged values, from two networks, proves the host overwrites a client-sent header. For x-forwarded-for, that test must also show exactly one hop is appended (rightmost is only the platform then).
LF_TRUSTED_IP_HEADER=
# Loose per-IP limit (every action), used only with LF_TRUSTED_IP_HEADER. Default 100/60.
LF_RATE_LIMIT_IP=

# Signs the local dev session cookie (memory backend, development only).
DEV_SESSION_SECRET=
