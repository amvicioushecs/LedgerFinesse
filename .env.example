# Variable NAMES only. Never put real values in this file.
# Local dev: copy to .env.local (git-ignored) and fill in values.
# Cloudflare: `wrangler secret put <NAME>` for secrets, `vars` in wrangler config for the rest.

# production | staging | development. Production refuses memory/mock/demo modes;
# anything else refuses live Stripe keys.
SITE_ENV=
# memory | supabase
LF_BACKEND=
# mock | stripe (stripe = TEST keys only on this branch)
STRIPE_MODE=
# demo | gemini
EXTRACTION_MODE=

NEXT_PUBLIC_APP_URL=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

GEMINI_API_KEY=
GEMINI_MODEL=

# Signs the local dev session cookie (memory backend only).
DEV_SESSION_SECRET=
