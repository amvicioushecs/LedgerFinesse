{
  "name": "ledgerfinesse",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "blog:build": "tsx scripts/build-blog.ts",
    "prebuild": "npm run blog:build",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build:cf": "npm run blog:build && opennextjs-cloudflare build",
    "preview:cf": "npm run build:cf && opennextjs-cloudflare preview",
    "test:e2e": "playwright test",
    "test:e2e:cf": "E2E_TARGET=worker SCREENSHOT_DIR=/workspace/ledgerfinesse/screenshots/v2/worker playwright test"
  },
  "dependencies": {
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3",
    "@neondatabase/auth": "^0.7.0-beta",
    "@neondatabase/serverless": "^1.2.0",
    "@opennextjs/cloudflare": "1.20.16",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "stripe": "23.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "gray-matter": "^4.0.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "5.0.5",
    "wrangler": "4.159.0",
    "ws": "^8.21.0"
  }
}
