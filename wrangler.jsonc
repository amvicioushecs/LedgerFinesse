// Build config only. `npm run build:spacefast` (the OpenNext adapter) reads this to produce the prebuilt worker
// that Spacefast Functions runs (`sf publish --prebuilt`), and `wrangler dev` uses it to run that worker in local
// workerd for `npm run test:e2e:worker`. Nothing deploys from here and no platform bindings are used: rate limits
// live in Neon Postgres (src/lib/rate-limit.ts). ASSETS is the adapter's static-asset binding.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ledgerfinesse-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" }
}
