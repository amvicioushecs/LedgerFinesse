// Builds the OpenNext worker (`npm run build:cf`) and runs it locally (`wrangler dev`, e2e). The hosting target is
// Spacefast Functions, which runs this prebuilt worker; nothing deploys from here. No Cloudflare bindings are used:
// rate limits live in Supabase Postgres (src/lib/rate-limit.ts).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ledgerfinesse-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true }
}
